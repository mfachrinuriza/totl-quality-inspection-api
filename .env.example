APP_NAME="Quality Inspection API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# phpMyAdmin (XAMPP / Laragon default: user root, tanpa password)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=QualityInspectionDb
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync
